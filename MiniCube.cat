CATALOG
  TITLE = "MiniCube"
  DESCRIPTION = "Minimal Highway Assignment Test Model"

  GROUP "MiniCube Tests"
    TITLE = "MiniCube Test Group"
    DESCRIPTION = "Simple all-or-nothing highway assignment"

    RUNGROUP "Highway Models"
      TITLE = "Highway Assignment Steps"

      RUNDEF "Test Assignment"
        TITLE = "MiniCube Highway Test"
        DESCRIPTION = "A simple AON highway assignment for MiniCube"

        SCRIPT = "SCRIPTS\minicube_assign.s"
        WORKDIR = "."
      ENDRUNDEF

    ENDRUNGROUP
  ENDGROUP

ENDCATALOG